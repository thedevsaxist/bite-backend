# Copy this file to .env and fill in the values.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# SQLite database file (created automatically if it does not exist)
DATABASE_URL=./data/app.db

# Comma-separated list of allowed origins, or * for any.
# The Flutter mobile app does not send an Origin header, so this only matters for web clients.
CORS_ORIGIN=*

# --- Auth ---
# Signs the short-lived access tokens (JWT).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh tokens are random strings stored (hashed) in the database, so they need no secret.
REFRESH_TOKEN_TTL_DAYS=30

# --- Social auth ---
# Leave empty to disable a provider (its endpoint then returns 503).
# Google: every OAuth client ID the Flutter app's ID tokens can be issued for, comma-separated
# (typically the iOS client ID and the web/"server" client ID used on Android).
GOOGLE_CLIENT_IDS=
# Apple: the iOS bundle ID, plus the Services ID if you also sign in with Apple on Android/web.
APPLE_CLIENT_IDS=

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
