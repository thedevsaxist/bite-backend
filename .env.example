# Copy this file to .env and fill in the values.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# SQLite database file (created automatically if it does not exist)
DATABASE_URL=./data/app.db

# Comma-separated list of allowed origins, or * for any.
# The Flutter mobile app does not send an Origin header, so this only matters for web clients.
CORS_ORIGIN=*

# --- Auth ---
# Signs the short-lived access tokens (JWT).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh tokens are random strings stored (hashed) in the database, so they need no secret.
REFRESH_TOKEN_TTL_DAYS=30

# --- Social auth ---
# Leave empty to disable a provider (its endpoint then returns 503).
# Google: every OAuth client ID the Flutter app's ID tokens can be issued for, comma-separated
# (typically the iOS client ID and the web/"server" client ID used on Android).
GOOGLE_CLIENT_IDS=
# Apple: the iOS bundle ID, plus the Services ID if you also sign in with Apple on Android/web.
APPLE_CLIENT_IDS=
# Firebase Auth (POST /auth/firebase): the project ID from Firebase console → Project settings →
# General. Not a secret, and no service account is needed: tokens are checked against Google's
# public keys. Google sign-in is accepted; Apple too once it's enabled in Firebase.
FIREBASE_PROJECT_ID=

# --- Uploads ---
# Where meal photos are stored: "local" (the UPLOAD_DIR folder) or "supabase" (Supabase Storage).
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# Supabase Storage (only used when STORAGE_DRIVER=supabase). Create a *private* bucket, and use the
# secret key (sb_secret_…, or the legacy service_role key) from Project Settings → API.
# It has full access to the project: keep it on the server only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=meal-images
# How long (in seconds) the signed photo links given to the app stay valid.
SIGNED_URL_TTL_SECONDS=3600
MAX_UPLOAD_SIZE_MB=10
# Sharpness score below which a photo is rejected as blurry (sharp food photos score ~180+).
# Lower it if real photos get rejected; raise it if blurry ones get through.
IMAGE_BLUR_THRESHOLD=30

# --- Food recognition ---
# Which AI service analyses meal photos: "anthropic" (Claude) or "gemini" (Google Gemini).
AI_PROVIDER=anthropic
# Keys are server-side only. Without the chosen provider's key the server still starts, but meal
# analysis returns 503 AI_NOT_CONFIGURED.
# Claude: https://platform.claude.com (Settings → API keys)
ANTHROPIC_API_KEY=
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Leave empty for the provider's default (claude-opus-5-5 or gemini-3.8-flash).
AI_MODEL=
# low | medium | high | xhigh | max: higher reasons more, but is slower and costs more.
AI_EFFORT=medium
AI_TIMEOUT_SECONDS=90
